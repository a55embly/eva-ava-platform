APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://chatbot:change-me@postgres:5432/chatbot
TENANT_ID=demo-company
LOCAL_KNOWLEDGE_PATH=/app/knowledge/demo
DEMO_EMPLOYEE_API_TOKEN=replace-with-at-least-32-random-characters
DEMO_ADMIN_API_TOKEN=replace-with-at-least-32-different-random-characters
